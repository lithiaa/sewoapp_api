// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js" 
  output        = "../generated/prisma"
  moduleFormat  = "esm"              
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  PARTNER
}

enum VerificationType {
  KTP
  SIM
  PASSPORT
  NPWP
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

model User{
  id Int @id @default(autoincrement())
  fullname String
  email String @unique
  password String
  phone_number String @unique
  address String
  role Role @default(CUSTOMER)
  is_verified Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  verification UserVerification? @relation("UserVerification")
  verified_records UserVerification[] @relation("UserVerificationAdmin")
  vehicles Vehicle[] @relation("partnerVehicles")
  otp_verifications OtpVerification[] @relation("OtpVerification")

  @@map("users")
}

model OtpVerification {
  id Int @id @default(autoincrement())
  user_id Int
  otp_code String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation("OtpVerification", fields: [user_id], references: [id])

  @@map("otp_verifications")
}

model UserVerification{
  id Int @id @default(autoincrement())
  user_id Int @unique
  verif_type VerificationType
  document_number String
  document_url String
  selfie_url String
  verification_status VerificationStatus @default(PENDING)
  verified_by Int?
  verified_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation("UserVerification", fields: [user_id], references: [id])
  verifiedBy User? @relation("UserVerificationAdmin", fields: [verified_by], references: [id])

  @@map("user_verifications")
}

model Category{
  id Int @id @default(autoincrement())
  name String @unique
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vehicles Vehicle[] @relation("CategoryVehicles")

  @@map("categories")
}

model Vehicle{
  id Int @id @default(autoincrement())
  partner_id Int
  category_id Int
  vehicle_name String
  price Float
  vehicle_year Int
  license_plate String @unique
  description String?
  status VehicleStatus @default(AVAILABLE)
  image_url String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  partner User @relation("partnerVehicles", fields: [partner_id], references: [id])
  category Category @relation("CategoryVehicles", fields: [category_id], references: [id])

  @@map("vehicles")
}