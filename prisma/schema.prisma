// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js" 
  output        = "../generated/prisma"
  moduleFormat  = "esm"              
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  PARTNER
}

enum VerificationType {
  KTP
  SIM
  PASSPORT
  NPWP
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  HYBRID
}

model User{
  id Int @id @default(autoincrement())
  fullname String
  username String @unique
  email String @unique
  password String
  phone_number String @unique
  address String
  role Role @default(CUSTOMER)
  is_verified Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  verification UserVerification? @relation("UserVerification")
  verified_records UserVerification[] @relation("UserVerificationAdmin")
  otp_verifications OtpVerification[] @relation("OtpVerification")
  ratings Rating[] @relation("CustomerRatings")
  mitra_ratings MitraRating[] @relation("CustomerRatings")
  favorites Favorite[] @relation("CustomerFavorites")
  mitra_profile MitraProfile? @relation("MitraProfiles")

  @@map("users")
}

model OtpVerification {
  id Int @id @default(autoincrement())
  user_id Int
  otp_code String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation("OtpVerification", fields: [user_id], references: [id])

  @@map("otp_verifications")
}

model PasswordResetToken {
  id Int @id @default(autoincrement())
  email String
  token String @unique
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("password_reset_tokens")
}

model UserVerification{
  id Int @id @default(autoincrement())
  user_id Int @unique
  verif_type VerificationType
  document_number String
  document_url String
  selfie_url String
  verification_status VerificationStatus @default(PENDING)
  verified_by Int?
  verified_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation("UserVerification", fields: [user_id], references: [id])
  verifiedBy User? @relation("UserVerificationAdmin", fields: [verified_by], references: [id])

  @@map("user_verifications")
}

model Category{
  id Int @id @default(autoincrement())
  name String @unique
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vehicles Vehicle[] @relation("CategoryVehicles")

  @@map("categories")
}

model MitraProfile{
  id Int @id @default(autoincrement())
  user_id Int @unique
  mitra_image String
  mitra_name String
  mitra_address String
  mitra_description String? @db.MediumText
  general_information String? @db.MediumText
  operating_hours String
  contact_number String
  longitude String
  latitude String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation("MitraProfiles", fields: [user_id], references: [id])
  vehicles Vehicle[] @relation("partnerVehicles")
  ratings MitraRating[] @relation("MitraRatings")
  partner_document PartnerDocument? @relation("MitraPartnerDocument")

  @@map("mitra_profiles")
}

model PartnerDocument {
  id Int @id @default(autoincrement())
  mitra_id Int @unique
  nib_document_url String
  npwp_document_url String
  bank_account_document_url String
  business_address String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  mitra MitraProfile @relation("MitraPartnerDocument", fields: [mitra_id], references: [id])
}


 model Vehicle{
  id Int @id @default(autoincrement())
  mitra_id Int
  category_id Int
  vehicle_name String
  price Float
  vehicle_year Int
  license_plate String @unique
  description String?
  status VehicleStatus @default(AVAILABLE)
  image_url String
  transmission TransmissionType
  specification String @db.MediumText
  features String @db.MediumText
  capacity Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  mitra MitraProfile @relation("partnerVehicles", fields: [mitra_id], references: [id])
  category Category @relation("CategoryVehicles", fields: [category_id], references: [id])
  ratings Rating[] @relation("VehicleRatings")
  favorites Favorite[] @relation("VehicleFavorites")

  @@map("vehicles")
}

model Rating{
  id Int @id @default(autoincrement())
  customer_id Int
  vehicle_id Int
  rating Int
  review String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer User @relation("CustomerRatings", fields: [customer_id], references: [id])
  vehicle Vehicle @relation("VehicleRatings", fields: [vehicle_id], references: [id])

  @@map("ratings")
}

model Favorite {
  id Int @id @default(autoincrement())
  customer_id Int
  vehicle_id Int
  created_at DateTime @default(now())

  customer User @relation("CustomerFavorites", fields: [customer_id], references: [id])
  vehicle Vehicle @relation("VehicleFavorites", fields: [vehicle_id], references: [id])

  @@unique([customer_id, vehicle_id])
  @@map("favorites")
}

model MitraRating{
  id Int @id @default(autoincrement())
  customer_id Int
  mitra_id Int
  rating Int
  review String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer User @relation("CustomerRatings", fields: [customer_id], references: [id])
  mitra MitraProfile @relation("MitraRatings", fields: [mitra_id], references: [id])

  @@unique([customer_id, mitra_id])
  @@map("mitra_ratings")
}